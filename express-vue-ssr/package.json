{
  "name": "express-vue-ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
    "start": "cross-env NODE_ENV=production node server.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
