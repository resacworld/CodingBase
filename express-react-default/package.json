{
  "name": "express-react-default",
  "version": "0.0.1",
  "description": "",
  "author": "Victor VIDALOT",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch --exclude \"client/**\" server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr client/entry-server.tsx --outDir dist/server",
    "start_prod": "cross-env NODE_ENV=production node server.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
